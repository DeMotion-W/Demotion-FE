{
  "name": "demotion-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "dev:ext": "cd extension/popup && npm run dev",
    "use:manifest:dev": "cp extension/manifest.dev.json extension/manifest.json",
    "use:manifest:prod": "cp extension/manifest.prod.json extension/manifest.json",
    "build:web": "next build",
    "build:ext": "cd extension/popup && npm install && npm run build",
    "build:copy": "rm -rf dist && mkdir dist && cp extension/manifest.json dist/ && cp extension/background.js dist/ && cp extension/content.js dist/ && cp -R extension/icons dist/icons && cp -R extension/popup/dist/* dist/",
    "build:all": "npm run build:web && npm run use:manifest:prod && npm run build:ext && npm run build:copy"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "axios": "^1.9.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.507.0",
    "next": "15.2.4",
    "react": "^19.0.0",
    "react-color": "^2.19.3",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-loading-skeleton": "^3.5.0",
    "recharts": "^2.15.3",
    "yup": "^1.6.1",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "msw": "^2.7.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
